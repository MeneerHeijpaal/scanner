# interactsh.config - self-hosted Interactsh (out-of-band interaction) server
#
# nuclei uses an Interactsh server to detect blind / out-of-band vulnerabilities
# (blind SSRF, blind command injection, OOB DNS/HTTP callbacks, etc.). Set the
# server your VPSes should report interactions to here.
#
# server_url : the Interactsh server hostname (passed to nuclei -interactsh-server)
# server_ip  : the server's IP address (for DNS / /etc/hosts pinning and for
#              running the self-hosted interactsh-server / interactsh-client)

server_url = h4xx.nl
server_ip  = 45.14.224.251
