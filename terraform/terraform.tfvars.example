# terraform.tfvars.example - template for terraform.tfvars
#
# Copy this file to terraform.tfvars and fill in your values:
#     cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored because it holds your Hetzner API token.

hcloud_token = "REPLACE_WITH_YOUR_HETZNER_CLOUD_API_TOKEN"

worker_count        = 3
server_type         = "cx22"
location            = "nbg1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_admin_cidrs     = ["203.0.113.10/32"]
es_endpoint         = "10.0.0.5:9200"
interactsh_server   = "h4xx.nl"
